<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Admin - Înrolare Parohie / Preot</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #0f172a; color: #f8fafc; padding: 40px; margin: 0; }
    .card { background: #1e293b; padding: 32px; border-radius: 12px; max-width: 480px; margin: 0 auto; border: 1px solid #334155; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
    h2 { margin-top: 0; color: #38bdf8; font-size: 1.4rem; }
    p.subtitle { color: #94a3b8; font-size: 0.85rem; margin-top: -6px; margin-bottom: 24px; }
    label { display: block; margin-top: 16px; margin-bottom: 6px; color: #cbd5e1; font-size: 0.88rem; font-weight: 500; }
    input, select { width: 100%; padding: 11px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: white; box-sizing: border-box; font-size: 0.95rem; }
    input:focus, select:focus { outline: none; border-color: #38bdf8; }
    .actions { margin-top: 28px; display: flex; align-items: center; gap: 16px; }
    button { background: #0284c7; color: white; border: none; padding: 11px 22px; border-radius: 6px; cursor: pointer; font-weight: 600; font-size: 0.95rem; }
    button:hover { background: #0369a1; }
    a { color: #94a3b8; text-decoration: none; font-size: 0.9rem; }
    a:hover { color: #f8fafc; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Înrolare Cont Parohie / Preot</h2>
    <p class="subtitle">Creditele AI sunt alocate automat în funcție de abonamentul ales</p>
    
    <form action="/admin/user/add" method="POST">
      <label for="email">Email Conectare (Parohie / Preot):</label>
      <input type="email" id="email" name="email" required placeholder="ex: parohia.sfantuldumitru@biserica.ro">

      <label for="parola">Parolă Inițială Acces:</label>
      <input type="password" id="parola" name="parola" required placeholder="Setați parola temporară de acces">

      <label for="id_abonament">Plan Abonament SaaS:</label>
      <select id="id_abonament" name="id_abonament" required>
        <% abonamente.forEach(function(ab) { %>
          <option value="<%= ab.id_abonament %>"><%= ab.nume_plan %> (<%= ab.credite_lunare %> credite lunare)</option>
        <% }); %>
      </select>

      <div class="actions">
        <button type="submit">Creează Contul de Preot</button>
        <a href="/admin">Anulare</a>
      </div>
    </form>
  </div>
</body>
</html>