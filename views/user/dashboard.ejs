<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Eternis - Panou Parohie</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; background-color: #0f172a; color: #f8fafc; padding: 30px; }
    .container { max-width: 900px; margin: 0 auto; }
    .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #334155; padding-bottom: 20px; margin-bottom: 30px; }
    .plan-card { background: #1e293b; border: 1px solid #38bdf8; padding: 24px; border-radius: 12px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center; }
    .plan-info h3 { margin: 0; color: #38bdf8; font-size: 1.4rem; }
    .plan-info p { margin: 6px 0 0; color: #94a3b8; font-size: 0.9rem; }
    .credits-badge { background: #0284c7; padding: 12px 20px; border-radius: 8px; font-weight: bold; font-size: 1.2rem; }
    
    .ai-tool { background: #1e293b; padding: 28px; border-radius: 12px; border: 1px solid #334155; }
    .ai-tool h2 { margin-top: 0; color: #f8fafc; font-size: 1.3rem; }
    label { display: block; margin-top: 15px; margin-bottom: 6px; color: #cbd5e1; }
    select, input, textarea { width: 100%; padding: 12px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: white; font-size: 0.95rem; }
    button { margin-top: 20px; background: #10b981; color: white; border: none; padding: 12px 24px; border-radius: 6px; font-size: 1rem; font-weight: 600; cursor: pointer; }
    button:hover { background: #059669; }

    .result-box { margin-top: 25px; padding: 20px; background: #0f172a; border-radius: 8px; border: 1px solid #334155; display: none; }
    .result-box h4 { margin-top: 0; color: #10b981; }
    .result-content { white-space: pre-line; color: #e2e8f0; line-height: 1.6; }
    .links-top { color: #94a3b8; text-decoration: none; margin-left: 15px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <h1 style="margin: 0; font-size: 1.8rem;">Panou Parohie / Preot</h1>
        <p style="margin: 4px 0 0; color: #94a3b8;">Conectat ca: <strong><%= user.email_utilizator %></strong></p>
      </div>
      <div>
        <a href="/admin" class="links-top">Vezi Panou Admin ➔</a>
      </div>
    </div>

    <!-- SECTIUNEA PLAN SaaS SI CREDITE -->
    <div class="plan-card">
      <div class="plan-info">
        <p>Abonament SaaS Activ</p>
        <h3><%= user.abonamente ? user.abonamente.nume_plan : 'Fără Plan' %></h3>
        <p>Beneficiezi de generări asistate de AI pentru predici și anunțuri parohiale.</p>
      </div>
      <div class="credits-badge">
        <span id="creditCount"><%= user.credite_disponibile %></span> credite AI
      </div>
    </div>

    <!-- CONTROALE FUNCTIONALITATE PRINCIPALA (API AI) -->
    <div class="ai-tool">
      <h2>🤖 Asistent AI Parohial (Generare Automată)</h2>
      <p style="color: #94a3b8; font-size: 0.88rem;">Fiecare generare consumă 1 credit din planul tău SaaS.</p>

      <form id="aiForm">
        <label for="tip_text">Tip conținut de generat:</label>
        <select id="tip_text" required>
          <option value="predica">Predică Duminicală / Sărbătoare</option>
          <option value="necrolog">Cuvânt de Rămas Bun / Necrolog</option>
          <option value="anunt">Anunț Parohial / Activitate</option>
        </select>

        <label for="tema">Tema sau ideile principale (ex: "Pilda Fiului Risipitor" sau "Nume Persoană"):</label>
        <input type="text" id="tema" placeholder="Introduceți tema..." required>

        <button type="submit" id="btnSubmit">✨ Generează Conținut cu AI</button>
      </form>

      <div id="resultBox" class="result-box">
        <h4>Rezultat Generat de API:</h4>
        <div id="resultContent" class="result-content"></div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('aiForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const tip_text = document.getElementById('tip_text').value;
      const tema = document.getElementById('tema').value;
      const userId = <%= user.id_utilizator %>;

      const btn = document.getElementById('btnSubmit');
      btn.disabled = true;
      btn.innerText = "Se generează...";

      try {
        const response = await fetch('/api/user/generate-ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, tip_text, tema })
        });

        const data = await response.json();

        if (data.success) {
          document.getElementById('resultContent').innerText = data.text;
          document.getElementById('resultBox').style.display = 'block';
          document.getElementById('creditCount').innerText = data.crediteRamase;
        } else {
          alert("Eroare: " + data.message);
        }
      } catch (err) {
        alert("Eroare la apelul API: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "✨ Generează Conținut cu AI";
      }
    });
  </script>
</body>
</html>