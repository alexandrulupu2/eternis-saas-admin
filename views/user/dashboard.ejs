<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>Eternis - Panou Parohie</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', -apple-system, sans-serif;
      background-color: #09090b;
      color: #f8fafc;
      padding: 40px 20px;
      min-height: 100vh;
    }
    .container { max-width: 950px; margin: 0 auto; }
    
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #d4af37;
      padding-bottom: 20px;
      margin-bottom: 35px;
    }
    .header h1 {
      font-size: 2.2rem;
      font-family: 'Georgia', serif;
      color: #ffffff;
      letter-spacing: 1px;
    }
    .header p { color: #a1a1aa; font-size: 0.95rem; margin-top: 4px; }

    .links-top {
      color: #d4af37;
      text-decoration: none;
      font-weight: 700;
      border: 1px solid #d4af37;
      padding: 10px 18px;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .links-top:hover { background: #d4af37; color: #000; }

    /* CARD PLAN SAAS SI CREDITE */
    .plan-card {
      background: #121215;
      border: 1px solid #d4af37;
      padding: 28px;
      border-radius: 14px;
      margin-bottom: 35px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 30px rgba(212, 175, 55, 0.15);
    }
    .plan-info h3 { margin: 0; color: #fef08a; font-size: 1.6rem; font-family: 'Georgia', serif; }
    .plan-info p { margin: 8px 0 0; color: #a1a1aa; font-size: 0.95rem; }
    
    .credits-badge {
      background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
      color: #000000;
      padding: 14px 24px;
      border-radius: 10px;
      font-weight: 900;
      font-size: 1.3rem;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    /* GENERATOR AI */
    .ai-tool {
      background: #121215;
      padding: 35px;
      border-radius: 14px;
      border: 1px solid #27272a;
      box-shadow: 0 15px 35px rgba(0,0,0,0.6);
    }
    .ai-tool h2 { margin-top: 0; color: #ffffff; font-size: 1.5rem; font-family: 'Georgia', serif; }
    
    label { display: block; margin-top: 20px; margin-bottom: 8px; color: #e4e4e7; font-weight: 600; }
    select, input {
      width: 100%;
      padding: 14px;
      border-radius: 8px;
      border: 1px solid #3f3f46;
      background: #09090b;
      color: white;
      font-size: 1rem;
    }
    select:focus, input:focus { outline: none; border-color: #d4af37; box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.2); }
    
    button {
      margin-top: 25px;
      width: 100%;
      background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%);
      color: #000000;
      border: none;
      padding: 16px;
      border-radius: 8px;
      font-size: 1.05rem;
      font-weight: 900;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: opacity 0.2s;
    }
    button:hover { opacity: 0.95; }

    .result-box {
      margin-top: 30px;
      padding: 24px;
      background: #09090b;
      border-radius: 10px;
      border: 1px solid #d4af37;
      display: none;
    }
    .result-box h4 { margin-top: 0; color: #fef08a; font-size: 1.1rem; }
    .result-content { white-space: pre-line; color: #e4e4e7; line-height: 1.7; margin-top: 10px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <h1>Panou Parohie / Preot</h1>
        <p>Conectat ca: <strong><%= user.email_utilizator %></strong></p>
      </div>
      <div>
        <a href="/admin" class="links-top">Panou Admin ➔</a>
      </div>
    </div>

    <div class="plan-card">
      <div class="plan-info">
        <p style="color: #d4af37; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">Abonament SaaS Activ</p>
        <h3><%= user.abonamente ? user.abonamente.nume_plan : 'Fără Plan' %></h3>
        <p>Beneficiezi de generări asistate de AI pentru predici și anunțuri parohiale.</p>
      </div>
      <div class="credits-badge">
        <span id="creditCount"><%= user.credite_disponibile %></span> credite AI
      </div>
    </div>

    <div class="ai-tool">
      <h2>🤖 Asistent AI Parohial (Generare Automată)</h2>
      <p style="color: #a1a1aa; font-size: 0.9rem; margin-top: 4px;">Fiecare generare consumă 1 credit din planul tău SaaS.</p>

      <form id="aiForm">
        <label for="tip_text">Tip conținut de generat:</label>
        <select id="tip_text" required>
          <option value="predica">Predică Duminicală / Sărbătoare</option>
          <option value="necrolog">Cuvânt de Rămas Bun / Necrolog</option>
          <option value="anunt">Anunț Parohial / Activitate</option>
        </select>

        <label for="tema">Tema sau ideile principale (ex: "Pilda Fiului Risipitor"):</label>
        <input type="text" id="tema" placeholder="Introduceți tema..." required>

        <button type="submit" id="btnSubmit">✨ Generează Conținut cu AI</button>
      </form>

      <div id="resultBox" class="result-box">
        <h4>Rezultat Generat de API:</h4>
        <div id="resultContent" class="result-content"></div>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('aiForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const tip_text = document.getElementById('tip_text').value;
      const tema = document.getElementById('tema').value;
      const userId = <%= user.id_utilizator %>;

      const btn = document.getElementById('btnSubmit');
      btn.disabled = true;
      btn.innerText = "Se generează...";

      try {
        const response = await fetch('/api/user/generate-ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, tip_text, tema })
        });

        const data = await response.json();

        if (data.success) {
          document.getElementById('resultContent').innerText = data.text;
          document.getElementById('resultBox').style.display = 'block';
          document.getElementById('creditCount').innerText = data.crediteRamase;
        } else {
          alert("Eroare: " + data.message);
        }
      } catch (err) {
        alert("Eroare la apelul API: " + err.message);
      } finally {
        btn.disabled = false;
        btn.innerText = "✨ Generează Conținut cu AI";
      }
    });
  </script>
</body>
</html>