<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <title>ETERNIS ADMIN - Panou Administrare</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #09090b !important;
      color: #f8fafc !important;
      min-height: 100vh;
      display: flex;
    }

    .sidebar {
      width: 260px;
      background-color: #121215 !important;
      border-right: 2px solid #d4af37 !important;
      padding: 30px 20px;
      display: flex;
      flex-direction: column;
    }

    .brand-logo {
      font-size: 1.6rem;
      font-weight: 900;
      color: #d4af37 !important;
      letter-spacing: 2px;
      margin-bottom: 40px;
      font-family: 'Georgia', serif;
    }

    .nav-list { list-style: none; }
    .nav-item { margin-bottom: 12px; }

    .nav-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: #a1a1aa !important;
      text-decoration: none;
      font-weight: 600;
      border-radius: 8px;
    }

    .nav-link.active, .nav-link:hover {
      background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%) !important;
      color: #000000 !important;
      font-weight: 800;
    }

    .main-content {
      flex: 1;
      padding: 40px;
      background-color: #09090b !important;
    }

    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 35px;
      border-bottom: 1px solid #27272a;
      padding-bottom: 20px;
    }

    .header-bar h1 {
      font-size: 2.2rem;
      font-family: 'Georgia', serif;
      color: #ffffff !important;
    }

    .btn-add {
      background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%) !important;
      color: #000000 !important;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 8px;
      font-weight: 900;
      font-size: 0.95rem;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 35px;
    }

    .stat-card {
      background: #121215 !important;
      border: 1px solid rgba(212, 175, 55, 0.4) !important;
      padding: 22px;
      border-radius: 12px;
    }

    .stat-card h4 {
      color: #a1a1aa !important;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 10px;
    }

    .stat-card .number {
      font-size: 2.2rem;
      font-weight: 900;
      color: #fef08a !important;
      font-family: 'Georgia', serif;
    }

    .table-container {
      background: #121215 !important;
      border: 1px solid #27272a !important;
      border-radius: 12px;
      overflow: hidden;
    }

    .table-title {
      font-size: 1.3rem;
      font-family: 'Georgia', serif;
      color: #ffffff !important;
      margin-bottom: 20px;
    }

    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 16px; text-align: left; border-bottom: 1px solid #27272a; }
    
    th {
      background: #1c1917 !important;
      color: #d4af37 !important;
      font-weight: 800;
      text-transform: uppercase;
      font-size: 0.8rem;
    }

    tr:hover { background: rgba(212, 175, 55, 0.05) !important; }

    .role-badge {
      background: rgba(212, 175, 55, 0.15) !important;
      color: #fef08a !important;
      border: 1px solid #d4af37 !important;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: bold;
    }

    .credits-count { color: #d4af37 !important; font-weight: 800; }
    .actions { display: flex; gap: 12px; align-items: center; }
    .btn-edit { color: #38bdf8 !important; text-decoration: none; font-weight: 600; }
    .btn-delete { color: #ef4444 !important; text-decoration: none; font-weight: 600; }
    
    .btn-credit-add {
      background: rgba(16, 185, 129, 0.15) !important;
      color: #34d399 !important;
      border: 1px solid #10b981 !important;
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="brand-logo">✝ ETERNIS ADMIN</div>
    <ul class="nav-list">
      <li class="nav-item"><a href="/admin" class="nav-link active">👥 Parohii Înrolate</a></li>
      <li class="nav-item"><a href="/admin/user/add" class="nav-link">➕ Înrolare Preot</a></li>
      <li class="nav-item" style="margin-top: 40px;"><a href="/login" class="nav-link" style="color: #ef4444 !important;">🚪 Deconectare</a></li>
    </ul>
  </div>

  <div class="main-content">
    <div class="header-bar">
      <div>
        <h1>Panou de Administrare</h1>
        <p style="color: #a1a1aa;">Gestiune conturi parohii/preoți și credite AI (Arhitectură MVC)</p>
      </div>
      <a href="/admin/user/add" class="btn-add">+ Înrolează Parohie / Preot</a>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <h4>Parohii Înrolate (USER)</h4>
        <div class="number"><%= utilizatori.length %></div>
      </div>
      <div class="stat-card">
        <h4>Familii Înregistrate</h4>
        <div class="number">3</div>
      </div>
      <div class="stat-card">
        <h4>Programări Active</h4>
        <div class="number">1</div>
      </div>
      <div class="stat-card">
        <h4>Cimitire Înrolate</h4>
        <div class="number">1</div>
      </div>
    </div>

    <h2 class="table-title">Conturi de Preoți / Parohii Înrolate</h2>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>EMAIL (LOGIN PREOT)</th>
            <th>ROL</th>
            <th>PLAN ABONAMENT</th>
            <th>CREDITE AI DISPONIBILE</th>
            <th>DATA ÎNROLĂRII</th>
            <th>ACȚIUNI</th>
          </tr>
        </thead>
        <tbody>
          <% utilizatori.forEach(user => { %>
            <tr>
              <td>#<%= user.id_utilizator %></td>
              <td><strong><%= user.email_utilizator %></strong></td>
              <td><span class="role-badge"><%= user.rol_utilizator %></span></td>
              <td><%= user.abonamente ? user.abonamente.nume_plan : 'Plan Free' %></td>
              <td><span class="credits-count"><%= user.credite_disponibile %> credite</span></td>
              <td style="color: #a1a1aa;">26.10.2026</td>
              <td>
                <div class="actions">
                  <a href="/admin/user/edit/<%= user.id_utilizator %>" class="btn-edit">Editează</a>
                  
                  <form action="/admin/user/add-credits/<%= user.id_utilizator %>" method="POST" style="display:inline;">
                    <button type="submit" class="btn-credit-add">Adaugă credite suplimentare</button>
                  </form>

                  <a href="/admin/user/delete/<%= user.id_utilizator %>" class="btn-delete" onclick="return confirm('Sigur dorești ștergerea contului?')">Șterge</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>